def save_value_report(data: Dict, filename: str = None):
    """保存价值投资报告为Markdown"""
    if not filename:
        filename = f"./{data['ticker']}-value-analysis-{data['date']}.md"
    
    with open(filename, 'w', encoding='utf-8') as f:
        f.write(f"# {data['name']} ({data['ticker']}) 价值投资分析报告\n\n")
        f.write(f"> 💡 投资理念: 买公司，不是买股票 | 和时间做朋友 | 左侧交易\n\n")
        f.write(f"**分析日期**: {data['date']}\n\n")
        
        f.write("## 📊 核心数据\n\n")
        f.write(f"- **股价**: ${data['price']['current']}\n")
        f.write(f"- **市值**: ${data['price']['market_cap_b']:.1f}B\n")
        f.write(f"- **52周区间**: ${data['price']['week_52_low']} - ${data['price']['week_52_high']}\n")
        f.write(f"- **Forward P/E**: {data['valuation']['forward_pe']}x\n\n")
        
        f.write("## 💰 巴菲特式估值\n\n")
        f.write(f"- **DCF内在价值**: ${data['valuation']['intrinsic_value']}\n")
        f.write(f"- **安全边际**: {data['valuation']['margin_of_safety']:+.1f}%\n")
        f.write(f"- **评级**: {'✅ 安全边际充足' if data['valuation']['margin_of_safety'] > 20 else '⏸️ 安全边际一般' if data['valuation']['margin_of_safety'] > 10 else '⚠️ 安全边际不足'}\n\n")
        
        f.write("## 🏰 护城河分析 (段永平五维)\n\n")
        f.write("| 维度 | 评分 |\n")
        f.write("|------|------|\n")
        for key, score in data['moat']['scores'].items():
            name = {"network": "网络效应", "brand": "品牌护城河", "tech": "技术护城河", 
                    "cost": "成本优势", "switching": "切换成本"}.get(key, key)
            f.write(f"| {name} | {'⭐' * score} |\n")
        f.write(f"\n**综合评级**: {data['moat']['rating']}护城河 ({data['moat']['average']}/5.0)\n\n")
        
        f.write("## 📈 未来1-5年价值估算\n\n")
        f.write("| 年限 | 目标价 | 年化回报 |\n")
        f.write("|------|--------|----------|\n")
        for year, value in data['future_value'].items():
            f.write(f"| {year}年 | ${value['value']} | {value['annual_return']:+.1f}% |\n")
        f.write("\n")
        
        f.write("## 🎯 投资评级\n\n")
        f.write(f"**{data['rating']}**\n\n")
        
        f.write("## 📋 左侧交易计划\n\n")
        f.write("| 层级 | 价格区间 | 仓位 |\n")
        f.write("|------|----------|------|\n")
        f.write(f"| 第一批(试仓) | ${data['entry_points']['first_batch'][0]}-${data['entry_points']['first_batch'][1]} | 20% |\n")
        f.write(f"| 第二批(加仓) | ${data['entry_points']['second_batch'][0]}-${data['entry_points']['second_batch'][1]} | 30% |\n")
        f.write(f"| 重仓区 | ${data['entry_points']['heavy'][0]}-${data['entry_points']['heavy'][1]} | 35% |\n")
        f.write(f"| 极端区 | <${data['entry_points']['extreme']} | 15% |\n\n")
        
        f.write('## 🕰️ "时间是朋友"持有逻辑\n\n')
        f.write(f"1. {data['moat']['rating']}护城河保护企业长期竞争力\n")
        if data['fundamentals']['roe']:
            f.write(f"2. ROE {data['fundamentals']['roe']}% 显示优秀的资本回报能力\n")
        f.write(f"3. 以低于内在价值的价格买入，安全边际充足\n")
        f.write(f"4. 持有3-5年，让企业价值复合增长\n")
        f.write(f"5. 忽略短期波动，专注长期价值\n")
    
    print(f"\n💾 报告已保存: {filename}")


def main():
    if len(sys.argv) < 2:
        print("Value Investing Stock Analyzer")
        print("巴菲特 + 段永平 投资理念")
        print("\nUsage: analyze-value <TICKER> [options]")
        print("Options:")
        print("  --save       Save report to file")
        print("  --format md  Output as markdown")
        print("  --format json Output as JSON")
        print("\nExamples:")
        print("  analyze-value AAPL")
        print("  analyze-value AMZN --save")
        print("  analyze-value 1810.HK --format md")
        sys.exit(1)
    
    ticker = sys.argv[1].upper()
    save = '--save' in sys.argv
    format_md = '--format md' in sys.argv or '-f md' in sys.argv
    format_json = '--format json' in sys.argv or '-f json' in sys.argv
    
    try:
        result = value_investing_analysis(ticker)
        
        if format_json:
            print(json.dumps(result, indent=2, ensure_ascii=False))
        elif format_md:
            save_value_report(result, f"{ticker}-value-analysis.md")
        else:
            print_value_report(result)
            if save:
                save_value_report(result)
    
    except Exception as e:
        print(f"Error analyzing {ticker}: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)


if __name__ == "__main__":
    main()
